        <mxCell id="nota_authz" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Autorização — fora do banco (Keycloak)&lt;/b&gt;&lt;br&gt;Pertencimento em grupos do Keycloak, nomeados pelo UUID do registro; a matriz papel → permissão é estática no backend (MatrizPermissoes.java).&lt;br&gt;&lt;br&gt;/_admin — Admin da Plataforma (conta exclusiva)&lt;br&gt;/org-{organizacao.id} — &lt;i&gt;organizacao.keycloak_group_id&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;/_dono · /_gestores · /_membros&lt;br&gt;&amp;nbsp;&amp;nbsp;/proj-{projeto.id} — &lt;i&gt;projeto.keycloak_group_id&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;/_dono · /_gestores · /_stakeholders_tecnicos · /_stakeholders_clientes&lt;br&gt;&lt;br&gt;&lt;i&gt;usuario.external_identity_id&lt;/i&gt; = id do usuário no Keycloak. Sem FK física entre banco e Keycloak." vertex="1"><mxGeometry x="370" y="1298" width="320" height="250" as="geometry" /></mxCell>
        <mxCell id="e1" parent="1" style="edgeStyle=orthogonalEdgeStyle;fontSize=12;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToMany;rounded=0;jumpStyle=arc;jumpSize=6;strokeColor=#6c8ebf;opacity=70;" value="" edge="1" source="usuario-r0" target="organizacao-r5"><mxGeometry relative="1" as="geometry" /></mxCell>
