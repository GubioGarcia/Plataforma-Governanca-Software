# POSTGRES
POSTGRES_DB=plataforma
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

# KEYCLOAK
KEYCLOAK_DB=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
# Client usado pelo back-end como resource server (validação de tokens JWT de usuários)
KEYCLOAK_CLIENT_ID=plataforma-api-client
KEYCLOAK_CLIENT_SECRET=plataforma-api-secret

# Client com service account usado pelo back-end para operações admin no Keycloak (criar/editar usuários)
KEYCLOAK_ADMIN_CLIENT_ID=plataforma-admin-client
KEYCLOAK_ADMIN_CLIENT_SECRET=plataforma-admin-secret

# URI interna (Docker) para buscar as chaves públicas — usada pelo backend container
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/plataforma_discovery/protocol/openid-connect/certs

# Issuer que vem DENTRO do token (campo "iss") — gerado com o hostname público (localhost)
KEYCLOAK_TOKEN_ISSUER=http://localhost/realms/plataforma_discovery
KEYCLOAK_TOKEN_URL=http://idprovider_keycloak:8080/realms/plataforma_discovery/protocol/openid-connect/token

# FRONTEND — variáveis usadas em tempo de BUILD do container React/Vite
# Keycloak é acessado pelo browser, portanto usa o endereço público (localhost)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=plataforma_discovery

# BACKEND
BACKEND_PORT=8081

# NGINX
NGINX_PORT=80